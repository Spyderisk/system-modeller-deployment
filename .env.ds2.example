# Copy this file to .env on the DS2 server and replace every REPLACE_ME value.

SERVICE_PROTOCOL=https
SERVICE_DOMAIN=ds2.it-innovation.soton.ac.uk
SERVICE_PORT=443

# Port used by the UoS reverse proxy to reach the deployment proxy.
PROXY_EXTERNAL_PORT=8089

EXTERNAL_KEYCLOAK_AUTH_SERVER_URL=https://REPLACE_ME/auth
KEYCLOAK_REALM=ssm-realm
KEYCLOAK_RESOURCE=system-modeller
KEYCLOAK_CREDENTIALS_SECRET=REPLACE_ME

DOCUMENTATION_URL=https://docs.spyderisk.org

# Replace branch-latest with the timestamped tags produced by the successful
# GitHub Actions runs before the production deployment.
SPYDERISK_VERSION=ds2-sdm-latest
SPYDERISK_ADAPTOR_VERSION=ds2-sdm-latest

# Exact HTTPS origins permitted to embed Spyderisk, separated by spaces.
FRAME_ANCESTORS=https://REPLACE_ME

DISPLAY_EULA=true
EULA_HTML=<p>The Spyderisk software is open source, licensed under <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache 2.0</a></p>
